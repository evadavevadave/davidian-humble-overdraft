@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

# Template: the build fills in the library extension (.dll, .so or .dylib) and the
# GUI class (ui:WindowsUI, ui:X11UI or ui:CocoaUI) for the platform.

<urn:davidian:humble-overdraft>
	a lv2:Plugin ;
	lv2:binary <humble_overdraft@LIB_EXT@> ;
	rdfs:seeAlso <humble_overdraft.ttl> .

<urn:davidian:humble-overdraft>
	ui:ui <urn:davidian:humble-overdraft#ui> .

<urn:davidian:humble-overdraft#ui>
	a @UI_CLASS@ ;
	ui:binary <humble_overdraft_ui@LIB_EXT@> ;
	lv2:optionalFeature ui:parent , ui:resize , ui:idleInterface ;
	lv2:extensionData ui:idleInterface .
